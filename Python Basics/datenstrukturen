# Dict Methoden

passwort_hashes = {
    "abc123": "twetzerzdbdfabbrsb",
    "124": "fhrgmnrgg24fben",
    "99111": "wedfbdfnrlkgn3434t3"
}

print(passwort_hashes.get("1111", "nicht vorhanden"))   # nicht vorhanden -> default wert, wenn keine Übereinstimmung

passwort_hashes["abc123"] = "123abc"
print(passwort_hashes)                                  # {"abc123": "123abc", "124": "fhrgmnrgg24fben", "99111": "wedfbdfnrlkgn3434t3"}

passwort_hashes["lol"] = "LOOOOL"                       
print(passwort_hashes)                                  # {"abc123": "123abc", "124": "fhrgmnrgg24fben", "99111": "wedfbdfnrlkgn3434t3", "lol": "LOOOOL"}

passwort_hashes.update({"hello": "moooin"})             # {"abc123": "123abc", "124": "fhrgmnrgg24fben", "99111": "wedfbdfnrlkgn3434t3", "lol": "LOOOOL", "hello": "mooooin"}   
passwort_hashes.update({"hello": "ciaoo"})              # {"abc123": "123abc", "124": "fhrgmnrgg24fben", "99111": "wedfbdfnrlkgn3434t3", "lol": "LOOOOL", "hello": "ciaoo"}  

del passwort_hashes["hello"]
print(passwort_hashes)                                  # {"abc123": "123abc", "124": "fhrgmnrgg24fben", "99111": "wedfbdfnrlkgn3434t3", "lol": "LOOOOL"}

copy_passwort = passwort_hashes.copy()                  # so bleibt orignals dict bestehen undiwrd durch kopiere dict nicht veränder
copy_passwort.clear()
print(copy_passwort)                                    # {}

print(list(passwort_hashes.keys()))                     # ["abc123", "124", "99111"]
print(list(passwort_hashes.values()))                   # ["123abc","fhrgmnrgg24fben","wedfbdfnrlkgn3434t3"]



