# Tupel
tupel = (1, 3, 5, 6, 7)             # feste Datenstruktur, kann nicht verändert werden

def addieren(a, b):
    summe = a + b
    return a, b, summe

ergbnis = addieren(1, 4)
print(type(ergbnis))                # tupel     wenn mehrere Werte mit Return zurückgegeben werden, dann entseht ein tupel. bei einem return wert nicht

