# Sets Methoden
zahlen = {1, 5, 3, 7, 0}
print(0 in zahlen)                  # true
print(10 in zahlen)                 # false

zahlen.add(-10) 
print(zahlen)                       # {1, 5, 3, 7, 0, -10}

zahlen.remove(-10)  
print(zahlen)                       # {1, 5, 3, 7, 0}

copy = zahlen.copy()
copy.clear()
print(copy)                         # {}      wenn keine echte kopie erstellt wird, wird die clear methode auch auf der mutter set lsite angewandt

liste = list(zahlen)
print(liste)                        # [1, 5, 3, 7, 0]         jetzt können wieder lsiten methoden angewendet werden 


